  "type": "object",
  "properties": {
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locatorFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requestedBase": {
          "type": [
            "string",
            "null"
          ]
        },
        "creationCommit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "primaryBranch": {
          "type": "string",
          "minLength": 1
        },
        "objectFormat": {
          "enum": [
            "sha1",
            "sha256"
          ]
        }
      },
      "required": [
        "name",
        "locatorFingerprint",
        "requestedBase",
        "creationCommit",
        "primaryBranch",
        "objectFormat"
      ],
      "additionalProperties": false
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "const": "open"
    },
    "headSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "required": [
    "repository",
    "providerId",
    "number",
    "url",
