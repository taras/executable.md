```json
{
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typeAware": {
      "type": "boolean",
      "default": false
    },
    "tsconfigPath": {
      "type": "string",
