    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "const": "open"
    },
    "headSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
