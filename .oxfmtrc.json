{
  // Markdown is source code here: oxfmt reindents fenced blocks and rewrites
  // `yield*` as `yield *`, which changes what a document does. Fixtures carry
  // the exact indentation the rule tests assert on.
  // `packages/*/npm` is generated dnt output, written by a test while the
  // battery runs; format-checking it fails on a file nobody wrote by hand.
  // `packages/cli/generated` is the prepared terminal runtime, held to the
  // hashes its recipe records.
  // The retained-repository history fixtures are journals an older revision
  // emitted, held to the SHA-256 their own receipt records: reserializing one
  // changes the bytes the evidence is, and the suite that continues them
  // verifies those hashes.
  "ignorePatterns": [
    "**/*.md",
    "scripts/tests/fixtures/**",
    "packages/cli/tests/fixtures/retained-repository-history/**",
    "**/npm/**",
    "packages/workflow/vendor/cloudflare-computer-dofs/**",
    "packages/acp/vendor/acpx/**",
    "packages/acp/vendor/adapters/claude/sdk-transform.mjs",
    "packages/cli/src/repl/vendor/freedom/**",
    "packages/cli/generated/**"
  ]
}
