+const char *clayterm_copy_text_key(const char *chars, int length) {
+  if (ct_active_context->transient_text_keys) {
+    return chars;
+  }
+  char *key = ct_active_context->text_keys + ct_active_context->text_keys_used;
+  memcpy(key, chars, length);
+  ct_active_context->text_keys_used += length;
+  return key;
 }
 
